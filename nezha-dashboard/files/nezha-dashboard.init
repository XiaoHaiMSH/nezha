#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0

USE_PROCD=1
START=99
STOP=10

NAME=nezha-dashboard
PROG=/usr/bin/nezha-dashboard
FW_SEC=nezha_dashboard

# set_yaml <file> <key> <raw yaml value>: replace or append a top-level key,
# everything else in config.yaml (changed from the admin UI) stays untouched
set_yaml() {
	local f="$1" k="$2" v="$3"
	local esc
	esc="$(printf '%s' "$v" | sed 's/[&|\\]/\\&/g')"
	if grep -q "^$k:" "$f"; then
		sed -i "s|^$k:.*|$k: $esc|" "$f"
	else
		echo "$k: $v" >> "$f"
	fi
}

update_firewall() {
	local want="$1" port="$2" cur cur_port
	cur="$(uci -q get firewall.$FW_SEC)"
	cur_port="$(uci -q get firewall.$FW_SEC.dest_port)"
	if [ "$want" = "1" ]; then
		[ "$cur" = "rule" ] && [ "$cur_port" = "$port" ] && return 0
		uci -q delete firewall.$FW_SEC
		uci -q set firewall.$FW_SEC=rule
		uci -q set firewall.$FW_SEC.name='Allow-Nezha-Dashboard'
		uci -q set firewall.$FW_SEC.src='wan'
		uci -q set firewall.$FW_SEC.proto='tcp'
		uci -q set firewall.$FW_SEC.dest_port="$port"
		uci -q set firewall.$FW_SEC.target='ACCEPT'
	else
		[ -z "$cur" ] && return 0
		uci -q delete firewall.$FW_SEC
	fi
	uci -q commit firewall
	/etc/init.d/firewall reload >/dev/null 2>&1
}

start_service() {
	local enabled data_dir listen_host listen_port install_host location language open_wan cfg

	config_load "$NAME"
	config_get_bool enabled main enabled 0
	if [ "$enabled" != "1" ]; then
		update_firewall 0
		return 0
	fi

	config_get data_dir main data_dir "/opt/nezha-dashboard"
	config_get listen_host main listen_host ""
	config_get listen_port main listen_port "8008"
	config_get install_host main install_host ""
	config_get location main location ""
	config_get language main language ""
	config_get_bool open_wan main open_wan 0

	mkdir -p "$data_dir/data"
	cfg="$data_dir/data/config.yaml"
	[ -f "$cfg" ] || : > "$cfg"
	chmod 600 "$cfg"

	set_yaml "$cfg" listen_port "$listen_port"
	[ -n "$listen_host" ]  && set_yaml "$cfg" listen_host "\"$listen_host\""
	[ -n "$install_host" ] && set_yaml "$cfg" install_host "\"$install_host\""
	[ -n "$location" ]     && set_yaml "$cfg" location "$location"
	[ -n "$language" ]     && set_yaml "$cfg" language "$language"

	update_firewall "$open_wan" "$listen_port"

	procd_open_instance
	procd_set_param command /bin/sh -c "cd '$data_dir' && exec $PROG -c data/config.yaml -db data/sqlite.db"
	procd_set_param respawn
	procd_set_param limits nofile="65535 65535"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/$NAME
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "$NAME"
}
